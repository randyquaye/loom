---
import Hero from '../components/Hero.astro'
import Base from '../layouts/Base.astro'
---

<Base title="LoomBox — your coding agents, one place to build">
  <Hero />

  <div class="wrap">
    <section class="chapter" id="workflow" aria-labelledby="ch-workspaces">
      <div class="chapter-copy">
        <p class="eyebrow">02</p>
        <h2 id="ch-workspaces">Give each task its own workspace.</h2>
        <p class="lede">
          Every workspace is a fresh git worktree on its own branch, with up to five agent
          conversations inside it.
        </p>
      </div>
      <figure class="media">
        <picture class="shot">
          <source media="(max-width: 720px)" srcset="/shots/s02-m.png" width="640" height="800" />
          <img
            src="/shots/s02.png"
            width="1268"
            height="986"
            alt="The sidebar listing three workspaces in the notes project, beside a task and its tool calls."
          />
        </picture>
      </figure>
    </section>

    <section class="chapter chapter--wide" aria-labelledby="ch-changes">
      <div class="chapter-copy">
        <p class="eyebrow">03</p>
        <h2 id="ch-changes">See what changed.</h2>
        <p class="lede">Read each change and browse the project files without leaving LoomBox.</p>
      </div>
      <figure class="media">
        <picture class="shot">
          <source media="(max-width: 720px)" srcset="/shots/s03-m.png" width="1408" height="1758" />
          <img
            src="/shots/s03.png"
            width="2816"
            height="1758"
            alt="A diff of src/search.ts adding a searchNotes function, beside the list of changed files."
          />
        </picture>
        <figcaption>One workspace's changes, ready to review.</figcaption>
      </figure>
    </section>

    <section class="chapter chapter--flip" aria-labelledby="ch-context">
      <div class="chapter-copy">
        <p class="eyebrow">04</p>
        <h2 id="ch-context">Pick up where you left off.</h2>
        <p class="lede">
          Conversations stay with the workspace they belong to, and past sessions are
          searchable.
        </p>
      </div>
      <figure class="media">
        <picture class="shot">
          <source media="(max-width: 720px)" srcset="/shots/s04-m.png" width="804" height="1006" />
          <img
            src="/shots/s04.png"
            width="1980"
            height="1320"
            alt="The Recent chats menu listing two earlier conversations in this workspace."
          />
        </picture>
      </figure>
    </section>

    <section class="faq" id="questions" aria-labelledby="ch-questions">
      <p class="eyebrow">05 · frequently asked questions</p>
      <h2 id="ch-questions">Things to know.</h2>
      <dl>
        <div class="faq-row">
          <dt>Which Macs does LoomBox run on?</dt>
          <dd>Apple Silicon Macs. The minimum macOS version is still to be confirmed.</dd>
        </div>
        <div class="faq-row">
          <dt>Which agents can I use?</dt>
          <dd>
            Claude and Codex through their own command-line tools. Gemini and Qwen work with an
            API key stored in your macOS Keychain.
          </dd>
        </div>
        <div class="faq-row">
          <dt>Do I need new subscriptions?</dt>
          <dd>No. Claude and Codex sign in with the plans you already have.</dd>
        </div>
        <div class="faq-row">
          <dt>Where does my work run?</dt>
          <dd>On your Mac. Each workspace is a git worktree of your own repository.</dd>
        </div>
        <div class="faq-row">
          <dt>Do I need an organization?</dt>
          <dd>
            No. Organizations can add cloud workspaces on a host they run, but local work needs
            no LoomBox account.
          </dd>
        </div>
      </dl>
    </section>

    <section class="closing" id="download" aria-labelledby="ch-download">
      <p class="eyebrow">06</p>
      <h2 id="ch-download">Bring your next task into LoomBox.</h2>
      <div class="actions">
        <a class="btn" href="#download">Download for macOS</a>
      </div>
      <p class="support">v0.1.0 · Apple Silicon · macOS version to be confirmed</p>
    </section>
  </div>
</Base>
