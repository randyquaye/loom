# Copy to NAME.env. No OAuth secrets or vault keys belong here.
AWS_PROFILE=loom
AWS_REGION=eu-north-1
EXPECTED_ACCOUNT_ID=000000000000
STACK_NAME=example
TF_VAR_hostname=loom.example.com
TF_VAR_instance_type=m7i-flex.large
TF_VAR_enable_kata_workspaces=true
TF_VAR_root_gb=30
TF_VAR_data_gb=50
# A public subnet is required without a default VPC. Its zone also holds the data disk.
# TF_VAR_subnet_id=subnet-0123456789abcdef0
# Set only after measuring capacity; deployment refuses an unset cap and floor.
LOOM_MAX_RUNNING_WORKSPACES=
LOOM_MIN_FREE_DISK_GB=
# Optional monitoring: confirm the SNS email subscription before unattended use.
# TF_VAR_alarm_email=operator@example.com
